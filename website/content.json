      "role": {
        "zh": "内容策划 / AI 视频制作",
        "en": "Content strategy / AI video production"
      },
      "challenge": {
        "zh": "围绕产品对信息、记忆与上下文的理解及召回能力，寻找用户能够快速代入的内容切入点。",
        "en": "Find relatable ways to explain how the product stores, understands, and recalls information and context."
      },
      "process": {
        "zh": "从用户痛点出发完成选题、脚本、AI 画面生成、剪辑与成片交付；探索 POV、Meme 与剧情短片，并根据 Instagram、TikTok 的内容特点调整表达。",
        "en": "Develop concepts, scripts, AI-generated visuals, edits, and finished videos. Explore POV, memes, and short narratives, adapting the approach for Instagram and TikTok."
      },
      "result": {
        "zh": "形成从产品卖点提炼到 AIGC 短视频制作的实践流程，持续优化人物一致性、镜头表达和素材质量。",
        "en": "Develop a practical workflow from product messaging to AI video production, refining character consistency, visual storytelling, and asset quality."
      },
